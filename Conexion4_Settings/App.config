<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio agrega esta entrada automáticamente al crear el valor en Configuración (Settings).
     El nombre es: <espacio de nombres>.Properties.Settings.<nombre del valor> -->
<configuration>
  <connectionStrings>
    <add name="Conexion4_Settings.Properties.Settings.TecnoHogarConnectionString"
         connectionString="Server=localhost;Database=tecnohogar;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
