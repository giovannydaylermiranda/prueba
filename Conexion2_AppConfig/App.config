<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo de configuración de la aplicación.
     Al compilar, Visual Studio lo copia junto al programa como Conexion2_AppConfig.dll.config -->
<configuration>
  <connectionStrings>
    <!-- name: el nombre con el que se busca desde el código.
         connectionString: la cadena. Para SQL Express: Server=.\SQLEXPRESS (aquí la barra va UNA vez). -->
    <add name="TecnoHogar"
         connectionString="Server=localhost;Database=tecnohogar;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
